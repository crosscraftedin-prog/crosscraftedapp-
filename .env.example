# ═══ CROSSCRAFTED — Environment Variables ═══
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.

# ─── CANONICAL PRODUCTION URL ───
# The canonical public URL of the deployed app. Used as the metadataBase
# for Open Graph / Twitter cards and for any server-side absolute URL
# construction. MUST be the user-facing domain — never the raw
# *.vercel.app deployment URL.
# In production: set this to https://www.koino.in in Vercel project env vars.
NEXT_PUBLIC_SITE_URL=https://www.koino.in

# ─── DEVELOPMENT ───
# For local development with SQLite:
#   DATABASE_URL=file:./db/custom.db
# For production with Supabase PostgreSQL:
#   DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-[region].pooler.supabase.com:5432/postgres

DATABASE_URL=file:/home/z/my-project/db/custom.db

# NextAuth is REMOVED. We use Supabase Auth now.
# These are no longer needed:
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=

# ─── SUPABASE (Auth + DB) ───
# Get these from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key — SERVER ONLY, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── GOOGLE OAUTH (configured in Supabase Dashboard, NOT here) ───
# Unlike next-auth, Google OAuth credentials are entered directly in:
#   Supabase Dashboard → Authentication → Providers → Google
# You do NOT need GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET here.

# ─── BOOTSTRAP ADMIN (optional) ───
# Comma-separated emails to auto-promote to admin role on first sign-in.
# Use this to bootstrap the first admin on a fresh deployment.
# Can be removed once the admin exists in the database.
# BOOTSTRAP_ADMIN_EMAIL=your-email@example.com
